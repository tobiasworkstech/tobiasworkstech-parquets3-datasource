FROM golang:1.24-bookworm

# Install build dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Allow auto toolchain download
ENV GOTOOLCHAIN=auto

# Copy go mod files first for caching
COPY tobiasworkstech-parquets3-datasource/go.mod tobiasworkstech-parquets3-datasource/go.sum ./

# Download dependencies
RUN go mod download

# Copy source code
COPY tobiasworkstech-parquets3-datasource/ ./

# Build with CGO enabled
RUN CGO_ENABLED=1 go build -o dist/gpx_parquet_s3_datasource_linux_arm64 ./pkg
